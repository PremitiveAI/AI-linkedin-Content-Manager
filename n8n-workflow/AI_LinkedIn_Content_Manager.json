        "jsCode": "const item = $input.item;\nconst combinedText = $('Current Content').first().json.combined_text;\n\nif (!combinedText || !String(combinedText).trim()) {\n  throw new Error('Approved LinkedIn content is empty. Publishing was blocked.');\n}\n\nif (!item.binary || !item.binary.data) {\n  throw new Error('Approved image is missing. Publishing was blocked.');\n}\n\nreturn item;"
