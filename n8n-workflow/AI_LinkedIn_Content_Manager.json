      "parameters": {
        "promptType": "define",
        "text": "=Write ONE complete LinkedIn post.\nTopic: {{ $('Validate Input').item.json.topic }}\nCategory: {{ $('Validate Input').item.json.category }}\nAudience: {{ $('Validate Input').item.json.targetAudience }}\nStrategy: {{ JSON.stringify($('Content Strategist').item.json.output) }}\nResearch (may be empty): {{ $json.research_summary }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are an expert LinkedIn ghostwriter. Write in a natural professional voice with a strong opening hook, immediate value, short mobile-friendly paragraphs, audience-specific examples, useful insight (not generic statements) and a natural conclusion. Add a CTA only when appropriate. No unnecessary emojis, no excessive formatting, no fake statistics, no generic AI language, no clickbait, no repetition. Also return a small set (0-4) of highly relevant niche hashtags; return an empty array if hashtags add no distribution value. Never invent statistics."
