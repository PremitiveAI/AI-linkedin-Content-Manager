      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const raw = $input.item.json.body || $input.item.json;\nconst clean = (s) => (typeof s === 'string' ? s.replace(/[\\u0000-\\u001F\\u007F]/g, '').replace(/\\s+/g, ' ').trim() : '');\nconst topic = clean(raw['Topic'] || raw.topic);\nconst category = clean(raw['Category'] || raw.category);\nconst targetAudience = clean(raw['Target Audience'] || raw.targetAudience);\nconst allowed = [\n  'AI & Automation','Technology','Business','Entrepreneurship','Leadership',\n  'Productivity','Marketing','Sales','Career & Personal Growth',\n  'Software & Development','Startups','Digital Transformation'\n];\nlet isValid = true;\nlet validationError = '';\nif (!topic || topic.length < 3) {\n  isValid = false; validationError = 'Topic is missing or too short. Please provide a meaningful topic.';\n} else if (!allowed.includes(category)) {\n  isValid = false; validationError = 'Category is not from the predefined list.';\n} else if (!targetAudience || targetAudience.length < 2) {\n  isValid = false; validationError = 'Target audience is required.';\n}\nreturn { json: { topic, category, targetAudience, isValid, validationError } };"
      },
