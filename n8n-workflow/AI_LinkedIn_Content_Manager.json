        "jsCode": "const item = $input.item;\nconst imgItem = $('Image Generation').first();\nconst binary = (imgItem && imgItem.binary) || {};\nconst keys = Object.keys(binary);\nconst imageKey = binary.data ? 'data' : keys[0];\n\nif (!imageKey || !binary[imageKey]) {\n  throw new Error(\n    'Generated image binary was not found. Check the Image Generation node output.'\n  );\n}\n\nitem.binary = item.binary || {};\nitem.binary.data = binary[imageKey];\nitem.json.image_ready = true;\nitem.json.image_binary_property = 'data';\n\nreturn item;"
      },
      "id": "57857e13-0612-48ce-8908-0dc76e0b3cb6",
